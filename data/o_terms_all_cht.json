[
  {
    "english": "O'Brien cubic polynomial",
    "traditional_chinese": "O'Brien 三次多項式",
    "definition_cht": "「O'Brien 三次多項式」是海洋與流體數值模式中用來近似垂直速度或垂向結構的一種插值／修正方法，透過三次多項式使離散層間解更平滑，並改善質量連續或邊界條件的一致性。",
    "source_url": "https://glossary.ametsoc.org/wiki/O%27Brien_cubic_polynomial"
  },
  {
    "english": "oasis effect",
    "traditional_chinese": "綠洲效應",
    "definition_cht": "「綠洲效應」指濕潤灌溉地、植生區或水體因蒸發散作用旺盛而使近地層氣溫低於周圍乾燥地表，並形成局地較涼微氣候的現象；常見於沙漠綠洲與灌溉農區。",
    "source_url": "https://glossary.ametsoc.org/wiki/oasis_effect"
  },
  {
    "english": "ob",
    "traditional_chinese": "觀測",
    "definition_cht": "「ob」是 observation 的縮寫，指氣象、航空或海洋作業中的一次觀測或觀測資料；在天氣圖分析、報文處理與資料同化中常用以代表實測觀測值。",
    "source_url": "https://glossary.ametsoc.org/wiki/ob"
  },
  {
    "english": "oberwind",
    "traditional_chinese": "奧伯風",
    "definition_cht": "「奧伯風」是德語文獻中使用的地方性風名，指特定地區所稱的一種局地風；現可直接取得的公開參考資料有限，詞義應依原始區域脈絡解讀，不宜泛化為一般高空風或盛行風的通稱。",
    "source_url": "https://glossary.ametsoc.org/wiki/oberwind"
  },
  {
    "english": "objective analysis",
    "traditional_chinese": "客觀分析",
    "definition_cht": "「客觀分析」指依既定數學或統計程序，將分散的觀測資料與背景場、前次分析或氣候值加以融合，產生連續且格點化的大氣或海洋分析場；其結果不直接依賴分析者個人主觀判斷。",
    "source_url": "https://glossary.ametsoc.org/wiki/objective_analysis"
  },
  {
    "english": "objective forecast",
    "traditional_chinese": "客觀預報",
    "definition_cht": "「客觀預報」指依固定的數值模式、統計關係或明確演算法所產生的預報，其結果在相同輸入資料下應可重現，不受預報員個人經驗或主觀判讀直接左右。",
    "source_url": "https://glossary.ametsoc.org/wiki/objective_forecast"
  },
  {
    "english": "oblique visual range",
    "traditional_chinese": "斜視程",
    "definition_cht": "「斜視程」又稱斜向能見度，指沿特定傾斜視線方向，觀測者以肉眼恰能辨識目標物的最大距離；常用於航空情境，以區別於水平能見度、垂直能見度與跑道視程。",
    "source_url": "https://glossary.ametsoc.org/wiki/oblique_visual_range"
  },
  {
    "english": "obliquity of the ecliptic",
    "traditional_chinese": "黃道傾角",
    "definition_cht": "「黃道傾角」是黃道面與地球赤道面之間的夾角，也就是地軸相對公轉軌道面的傾斜程度；其值約為 23.4°，是造成季節變化與太陽高度年變化的重要天文因素。",
    "source_url": "https://glossary.ametsoc.org/wiki/obliquity_of_the_ecliptic"
  },
  {
    "english": "obscuration",
    "traditional_chinese": "遮蔽",
    "definition_cht": "「遮蔽」指因霧、煙、塵、雪或其他遮蔽物使天空或目標物無法清楚看見的現象；在航空氣象中特別常指遮蔽視線或遮斷垂直能見度的各類近地層大氣現象。",
    "source_url": "https://glossary.ametsoc.org/wiki/obscuration"
  },
  {
    "english": "obscuring phenomenon",
    "traditional_chinese": "遮蔽現象",
    "definition_cht": "「遮蔽現象」指空氣中懸浮或近地面的粒子、液滴或冰晶聚集到足以明顯降低視程的現象，例如霧、靄、煙、塵、飛雪、沙塵或火山灰等。",
    "source_url": "https://glossary.ametsoc.org/wiki/obscuring_phenomenon"
  },
  {
    "english": "observation well",
    "traditional_chinese": "觀測井",
    "definition_cht": "「觀測井」是為量測含水層或地下水狀態而設置的井，用於監測地下水位、水溫、水質或水壓變化，常見於水文地質與地下水資源管理。",
    "source_url": "https://glossary.ametsoc.org/wiki/observation_well"
  },
  {
    "english": "observational day",
    "traditional_chinese": "觀測日",
    "definition_cht": "「觀測日」指氣象觀測資料所對應的一個完整統計日；自動觀測系統通常以曆日為準，而每日僅定時觀測一次時，則多指截至該次觀測時刻之前的 24 小時。",
    "source_url": "https://glossary.ametsoc.org/wiki/observational_day"
  },
  {
    "english": "observational error",
    "traditional_chinese": "觀測誤差",
    "definition_cht": "「觀測誤差」是某一量的觀測值與其真值之間的差異，可來自儀器校準、人為讀值、取樣限制、代表性不足或環境干擾等因素。",
    "source_url": "https://glossary.ametsoc.org/wiki/observational_error"
  },
  {
    "english": "observational network",
    "traditional_chinese": "觀測網",
    "definition_cht": "「觀測網」指為特定目的而在一定區域內配置的多個觀測站、感測器或平台所組成的系統，用於持續蒐集、交換與整合氣象、水文或環境資料。",
    "source_url": "https://glossary.ametsoc.org/wiki/observational_network"
  },
  {
    "english": "observer",
    "traditional_chinese": "觀測員",
    "definition_cht": "「觀測員」指依法或依作業規範執行並記錄氣象觀測的人員，負責判讀天氣現象、操作儀器、整理資料，並將觀測結果及時回報至作業中心。",
    "source_url": "https://glossary.ametsoc.org/wiki/observer"
  },
  {
    "english": "observing systems simulation experiment",
    "traditional_chinese": "觀測系統模擬實驗",
    "definition_cht": "「觀測系統模擬實驗」常縮寫為 OSSE，指先以模式產生擬真大氣或海洋場，再模擬特定觀測系統可取得的資料，藉此評估新觀測資料加入分析或預報系統後的潛在效益。",
    "source_url": "https://glossary.ametsoc.org/wiki/observing_systems_simulation_experiment"
  },
  {
    "english": "obstacle flow signature",
    "traditional_chinese": "障礙流特徵",
    "definition_cht": "「障礙流特徵」指都卜勒雷達上所見，強烈雷暴上升氣流區如同障礙物般使中層氣流繞流而形成的速度場訊號；其典型表現為上升氣流兩側流速增強，而下游尾流區流速減弱或反轉。",
    "source_url": "https://glossary.ametsoc.org/wiki/obstacle_flow_signature"
  },
  {
    "english": "obstruction to vision",
    "traditional_chinese": "視線障礙",
    "definition_cht": "「視線障礙」指任何足以降低能見度、妨礙目標辨識或阻礙飛航視覺判讀的天氣或懸浮現象，常包括霧、靄、煙、揚塵、飛雪與強降水。",
    "source_url": "https://glossary.ametsoc.org/wiki/obstruction_to_vision"
  },
  {
    "english": "Obukhov length",
    "traditional_chinese": "奧布霍夫長度",
    "definition_cht": "「奧布霍夫長度」是邊界層氣象中描述浮力與機械剪切對湍流影響相對強弱的特徵長度尺度；其值可用於判別近地層穩定度，通常穩定層結為正、不穩定層結為負，中性層結則趨近無限大。",
    "source_url": "https://glossary.ametsoc.org/wiki/Obukhov_length"
  },
  {
    "english": "occluded cyclone",
    "traditional_chinese": "囚錮氣旋",
    "definition_cht": "「囚錮氣旋」指已發展出囚錮鋒的中緯度氣旋，通常表示冷鋒已追上暖鋒，暖空氣被抬升離開地面，氣旋進入較成熟或逐漸減弱的發展階段。",
    "source_url": "https://glossary.ametsoc.org/wiki/occluded_cyclone"
  },
  {
    "english": "occluded depression",
    "traditional_chinese": "囚錮低壓",
    "definition_cht": "「囚錮低壓」指已有囚錮鋒形成的低壓系統，也就是冷鋒追上暖鋒後，暖區在地面分析上被切離的低壓中心。",
    "source_url": "https://glossary.ametsoc.org/wiki/occluded_depression"
  },
  {
    "english": "occluded front",
    "traditional_chinese": "囚錮鋒",
    "definition_cht": "「囚錮鋒」是冷鋒追上暖鋒後形成的鋒面，此時暖空氣被抬升離開地面，低壓中心附近的地面分析轉為冷、暖空氣直接相接；常伴隨廣泛雲系、降水與風向轉變。",
    "source_url": "https://glossary.ametsoc.org/wiki/occluded_front"
  },
  {
    "english": "occlusion",
    "traditional_chinese": "囚錮作用",
    "definition_cht": "「囚錮作用」指中緯度氣旋發展過程中冷鋒追上暖鋒、使暖空氣自地面抬升並形成囚錮鋒的過程，為鋒面氣旋邁向成熟的重要階段。",
    "source_url": "https://glossary.ametsoc.org/wiki/occlusion"
  },
  {
    "english": "ocean",
    "traditional_chinese": "海洋",
    "definition_cht": "「海洋」指覆蓋地球大部分表面、彼此相連通的巨大鹹水體總稱；在氣象與海洋學中，也常指其中任一大洋分區，以及其與大氣之間進行熱量、水氣與動量交換的海氣系統。",
    "source_url": "https://glossary.ametsoc.org/wiki/ocean"
  },
  {
    "english": "ocean conveyor belt",
    "traditional_chinese": "全球海洋輸送帶",
    "definition_cht": "「全球海洋輸送帶」是指由溫度與鹽度差異所造成的密度驅動深層環流，並與風生表層環流相互連結而成的全球尺度海洋翻轉循環；其典型特徵包括北大西洋深水下沉、深層跨洋盆輸送，以及其他海域的上升回返。",
    "source_url": "https://glossary.ametsoc.org/wiki/ocean_conveyor_belt"
  },
  {
    "english": "ocean current",
    "traditional_chinese": "洋流",
    "definition_cht": "「洋流」指海水沿可辨識路徑持續或週期性流動的現象，可由風應力、密度梯度、潮汐、地形與科氏力等共同驅動，並負責熱量、鹽度與物質的海洋輸送。",
    "source_url": "https://glossary.ametsoc.org/wiki/ocean_current"
  },
  {
    "english": "ocean mixing",
    "traditional_chinese": "海洋混合",
    "definition_cht": "「海洋混合」指不同海水團之間透過湍流、對流、風浪、潮汐或剪切等作用而發生的性質交換與混合作用，會改變溫度、鹽度、密度、養分與溶氧的垂直或水平分布。",
    "source_url": "https://glossary.ametsoc.org/wiki/ocean_mixing"
  },
  {
    "english": "ocean station",
    "traditional_chinese": "海洋測站",
    "definition_cht": "「海洋測站」指海上預先劃定、供海洋測站船巡弋或值守的特定作業區域；執勤船舶位於該區域範圍內時稱為在站（on station），用以持續執行海上氣象與海況觀測。",
    "source_url": "https://glossary.ametsoc.org/wiki/ocean_station"
  },
  {
    "english": "ocean station vessel",
    "traditional_chinese": "海洋測站船",
    "definition_cht": "「海洋測站船」又常縮寫為 OSV，指受派在海洋測站巡弋或值守的遠洋船舶，配備人員與儀器以持續進行海面與高空氣象觀測，並回報天氣、海況及上空資料。",
    "source_url": "https://glossary.ametsoc.org/wiki/ocean_station_vessel"
  },
  {
    "english": "Ocean Topography Experiment",
    "traditional_chinese": "海洋地形實驗",
    "definition_cht": "「海洋地形實驗」通常指 TOPEX，尤以 TOPEX/Poseidon 衛星任務最具代表性；該任務利用雷達高度計量測海面高度，並配合微波輻射計修正大氣水汽影響，以支援海洋環流與海平面研究。",
    "source_url": "https://glossary.ametsoc.org/wiki/Ocean_Topography_Experiment"
  },
  {
    "english": "ocean waves",
    "traditional_chinese": "海浪",
    "definition_cht": "「海浪」指海洋表面受風力擾動所產生的波動，主要受重力控制；對於較短波長的波，表面張力亦具重要影響。海浪包含風浪與湧浪等不同型態。",
    "source_url": "https://glossary.ametsoc.org/wiki/ocean_waves"
  },
  {
    "english": "ocean weather station",
    "traditional_chinese": "海洋氣象站",
    "definition_cht": "「海洋氣象站」依世界氣象組織用法，指海上特定位置由設備完善且有人值守的船舶或平台持續觀測天氣與海況，並透過國際交換系統回報觀測資料的海上測站。",
    "source_url": "https://glossary.ametsoc.org/wiki/ocean_weather_station"
  },
  {
    "english": "oceanic meteorology",
    "traditional_chinese": "海洋氣象學",
    "definition_cht": "「海洋氣象學」是研究海洋與大氣之間相互作用的氣象學分支，涵蓋海氣熱量、水氣與動量交換，以及其對海上天氣、海況與氣候變化的影響。",
    "source_url": "https://glossary.ametsoc.org/wiki/oceanic_meteorology"
  },
  {
    "english": "oceanicity",
    "traditional_chinese": "海洋性",
    "definition_cht": "「海洋性」指某地氣候受海洋調節影響的程度，通常表現為年溫差較小、濕度較高、降水較均勻且季節變化較不劇烈；其概念與大陸性相對。",
    "source_url": "https://glossary.ametsoc.org/wiki/oceanicity"
  },
  {
    "english": "oceanography",
    "traditional_chinese": "海洋學",
    "definition_cht": "「海洋學」是綜合研究海洋的科學，涵蓋海洋的物理邊界、海水的物理與化學性質、海洋環流、海底地形，以及海洋生物與相關地球系統過程。",
    "source_url": "https://glossary.ametsoc.org/wiki/oceanography"
  },
  {
    "english": "octa",
    "traditional_chinese": "八分雲量單位",
    "definition_cht": "「octa」是將全天空視野的雲覆蓋程度劃分為八等分時所使用的雲量單位；0 octa 表示晴空，8 octa 表示全天空被雲遮蔽，常用於人工觀測、航空氣象與天氣報告。",
    "source_url": "https://glossary.ametsoc.org/wiki/octa"
  },
  {
    "english": "octane",
    "traditional_chinese": "辛烷",
    "definition_cht": "「辛烷」是化學式為 C8H18 的烷類化合物，常作為汽油抗爆性比較中的基準物質之一；在氣象與大氣化學語境中，通常出現在燃料性質、揮發性有機物或污染排放討論。",
    "source_url": "https://glossary.ametsoc.org/wiki/octane"
  },
  {
    "english": "odd chlorine",
    "traditional_chinese": "奇數氯",
    "definition_cht": "「奇數氯」通常記為 ClOx，指平流層臭氧化學中可快速彼此轉換的一組無機含氯活性化學種總稱，核心成員包括 Cl 與 ClO，並常延伸包含相關無機氯物種；此化學族在催化臭氧消耗過程中具有關鍵作用。",
    "source_url": "https://glossary.ametsoc.org/wiki/odd_chlorine"
  },
  {
    "english": "odd hydrogen",
    "traditional_chinese": "奇數氫",
    "definition_cht": "「奇數氫」通常記為 HOx，指由 H、OH 與 HO2 所組成、可快速彼此轉換的反應性化學族，在平流層與對流層光化學中均扮演重要角色，並可參與臭氧生成與破壞反應。",
    "source_url": "https://glossary.ametsoc.org/wiki/odd_hydrogen"
  },
  {
    "english": "Odd oxygen",
    "traditional_chinese": "奇數氧",
    "definition_cht": "「奇數氧」指原子氧 O 與臭氧 O3 濃度的總和；在低層大氣中通常因臭氧濃度遠高於原子氧，其數值常可近似視為臭氧濃度，為分析大氣光化學的重要量。",
    "source_url": "https://glossary.ametsoc.org/wiki/Odd_oxygen"
  },
  {
    "english": "odd-oxygen system",
    "traditional_chinese": "奇數氧系統",
    "definition_cht": "「奇數氧系統」指包含奇數個氧原子的化學物種集合，主要為原子氧 O 與臭氧 O3；此概念常用於平流層與中高層大氣臭氧光化學分析，以整體追蹤臭氧生成、破壞與轉換。",
    "source_url": "https://glossary.ametsoc.org/wiki/odd-oxygen_system"
  },
  {
    "english": "oe",
    "traditional_chinese": "奧斯特（單位符號）",
    "definition_cht": "「Oe」是 oersted 的單位符號，為厘米－克－秒制（cgs）中磁場強度 H 的單位記號，常見於地磁與電磁相關文獻。",
    "source_url": "https://glossary.ametsoc.org/wiki/oe"
  },
  {
    "english": "oersted",
    "traditional_chinese": "奧斯特",
    "definition_cht": "「奧斯特」是厘米－克－秒制（cgs）中磁場強度 H 的單位，符號為 Oe；1 Oe 約對應 1000/(4π) A/m，常用於地磁、磁性材料與電磁測量。",
    "source_url": "https://glossary.ametsoc.org/wiki/oersted"
  },
  {
    "english": "off-airways",
    "traditional_chinese": "偏離航路",
    "definition_cht": "「偏離航路」主要用於航空與航空氣象，指航空器未沿既定航空路線（airway）飛行，而是在航路系統之外進行航行或作業；此類飛行通常仍需依相關航管程序與導航能力執行。",
    "source_url": "https://glossary.ametsoc.org/wiki/off-airways"
  },
  {
    "english": "off-center PPI scope",
    "traditional_chinese": "偏心式 PPI 顯示器",
    "definition_cht": "「偏心式 PPI 顯示器」指平面位置指示器（PPI）的一種雷達顯示方式，將雷達站位置由螢幕中心移開，以便擴大顯示某一方向或前方區域的回波範圍，常用於航海、航空或天氣雷達判讀。",
    "source_url": "https://glossary.ametsoc.org/wiki/off-center_PPI_scope"
  },
  {
    "english": "offshore wind",
    "traditional_chinese": "離岸風",
    "definition_cht": "「離岸風」指由陸地吹向海面的風，即風向朝離岸方向；其形成常與海陸熱力差異、地形或天氣系統配置有關，對近岸海況、污染擴散與沿海天氣具有重要影響。",
    "source_url": "https://glossary.ametsoc.org/wiki/offshore_wind"
  },
  {
    "english": "Ogasawara high",
    "traditional_chinese": "小笠原高壓",
    "definition_cht": "「小笠原高壓」是日本氣象用語，通常指夏半年影響日本附近海域的西北太平洋副熱帶高壓；因其常位於小笠原群島附近而得名，與東亞夏季晴熱、穩定天氣及颱風路徑配置密切相關。",
    "source_url": "https://glossary.ametsoc.org/wiki/Ogasawara_high"
  },
  {
    "english": "ogive",
    "traditional_chinese": "累積頻率曲線",
    "definition_cht": "「累積頻率曲線」為將累積次數或累積相對頻率隨變數值變化繪成的曲線，常用於氣象、水文與統計分析，以表示某一量值不超過或至少達到某門檻的累積分布特性。",
    "source_url": "https://glossary.ametsoc.org/wiki/ogive"
  },
  {
    "english": "ohmic current",
    "traditional_chinese": "歐姆電流",
    "definition_cht": "「歐姆電流」指符合歐姆定律的導電電流，其大小與介質電導率及外加電場強度成正比；在大氣電學中，常用以描述空氣中由電場驅動的傳導電流成分。",
    "source_url": "https://glossary.ametsoc.org/wiki/ohmic_current"
  },
  {
    "english": "oil slick",
    "traditional_chinese": "浮油膜",
    "definition_cht": "「浮油膜」指漂浮於海面、河面或其他水體表面的薄層油類污染物；其可由洩漏、排放或事故形成，會改變水面反照與表面粗糙度，並對海洋環境與遙測判識造成影響。",
    "source_url": "https://glossary.ametsoc.org/wiki/oil_slick"
  },
  {
    "english": "old snow",
    "traditional_chinese": "陳雪",
    "definition_cht": "「陳雪」指降落後已在地表停留一段時間、並經歷壓密、融凍或再結晶等變質作用的積雪；其晶體形態、密度與反照率通常已不同於新雪。",
    "source_url": "https://glossary.ametsoc.org/wiki/old_snow"
  },
  {
    "english": "Old Wives' summer",
    "traditional_chinese": "晚秋暖和期",
    "definition_cht": "「晚秋暖和期」為英語俗稱，意指秋季後段短暫出現的反常溫暖、乾燥而較穩定的天氣，概念上近似 Indian summer；多見於溫帶地區，常發生在初霜之後或接近其後。",
    "source_url": "https://glossary.ametsoc.org/wiki/Old_Wives%27_summer"
  },
  {
    "english": "Olland cycle",
    "traditional_chinese": "奧蘭循環",
    "definition_cht": "「奧蘭循環」為較少見的專門術語；現有常見氣象與通用參考來源對其記載有限，通常僅將其視為某種循環性變化或理論週期名稱。基於目前可得資料不足，暫保留音譯，待取得更明確的權威來源後再細化定義。",
    "source_url": "https://glossary.ametsoc.org/wiki/Olland_cycle"
  },
  {
    "english": "OLS",
    "traditional_chinese": "普通最小平方法",
    "definition_cht": "「普通最小平方法」是統計與氣象資料分析中常用的參數估計方法，透過最小化觀測值與模型估計值之間殘差平方和，求得線性回歸或其他線性模型的最佳擬合係數。",
    "source_url": "https://glossary.ametsoc.org/wiki/OLS"
  },
  {
    "english": "ombrometer",
    "traditional_chinese": "雨量計",
    "definition_cht": "「雨量計」是量測一定期間內液態降水量的儀器，又稱 ombrometer 或 pluviometer；氣象與水文觀測常以其測得之降雨深度評估降水強度、累積雨量與區域水文反應。",
    "source_url": "https://glossary.ametsoc.org/wiki/ombrometer"
  },
  {
    "english": "ombroscope",
    "traditional_chinese": "驗雨器",
    "definition_cht": "「驗雨器」是用以偵測是否正在降雨或記錄降雨發生情形的儀器，著重於顯示或指示雨是否出現，而不一定像雨量計那樣直接量得精確降水量。",
    "source_url": "https://glossary.ametsoc.org/wiki/ombroscope"
  },
  {
    "english": "omega equation",
    "traditional_chinese": "歐米伽方程",
    "definition_cht": "「歐米伽方程」是天氣動力學與綜觀氣象學中的診斷方程，用於在氣壓座標下估算大氣垂直運動速度 ω；常依渦度平流、溫度平流與差動加熱等強迫項分析上升與下沉區域。",
    "source_url": "https://glossary.ametsoc.org/wiki/omega_equation"
  },
  {
    "english": "omega sun",
    "traditional_chinese": "歐米伽太陽",
    "definition_cht": "「歐米伽太陽」指日出或日落前後，因近地平線大氣折射與海面上方溫度逆增層造成下方日像變形，令太陽外觀短暫呈現希臘字母 Ω 形狀的海市蜃樓光學現象。",
    "source_url": "https://glossary.ametsoc.org/wiki/omega_sun"
  },
  {
    "english": "on and off instruments",
    "traditional_chinese": "開關式儀器",
    "definition_cht": "「開關式儀器」指輸出僅表示某一現象是否發生、某一閾值是否被超過，或設備是否處於啟動／停止狀態的儀器；其訊號通常為二元或接點式，而非連續量測數值。",
    "source_url": "https://glossary.ametsoc.org/wiki/on_and_off_instruments"
  },
  {
    "english": "on top",
    "traditional_chinese": "雲上飛行",
    "definition_cht": "「雲上飛行」為航空用語，指航空器位於雲層上方飛行，通常上方天空較為晴朗，而下方則存在雲層或雲海；此情況常用於飛航描述與目視／儀器飛行作業判斷。",
    "source_url": "https://glossary.ametsoc.org/wiki/on_top"
  },
  {
    "english": "one-and-a-half order closure",
    "traditional_chinese": "一點五階閉合",
    "definition_cht": "「一點五階閉合」是邊界層與湍流參數化中的閉合方法，除預報平均場外，並另外預報湍流動能等二階量，再以診斷方式表示更高階通量或統計量，因此介於一階與二階閉合之間。",
    "source_url": "https://glossary.ametsoc.org/wiki/one-and-a-half_order_closure"
  },
  {
    "english": "one-dimensional model",
    "traditional_chinese": "一維模式",
    "definition_cht": "「一維模式」指只在一個空間方向上明確描述變化的理論或數值模式，其他方向則被忽略、平均化或以參數化處理；常用於研究垂直大氣柱、土壤、海洋混合層或河道等問題。",
    "source_url": "https://glossary.ametsoc.org/wiki/one-dimensional_model"
  },
  {
    "english": "one-way entrainment process",
    "traditional_chinese": "單向捲入過程",
    "definition_cht": "「單向捲入過程」指流體、雲體或混合層邊界只由一側持續捲入外部空氣或其他介質，而不明顯伴隨反向回混或對等交換的混合過程；此概念常用於理想化描述雲物理與邊界層演變。",
    "source_url": "https://glossary.ametsoc.org/wiki/one-way_entrainment_process"
  },
  {
    "english": "onshore wind",
    "traditional_chinese": "向岸風",
    "definition_cht": "向岸風指風由海面或較大水體吹向陸地的風，為近岸地區相對風向的描述；在局地環流中常見於白天的海風，可將較涼濕空氣帶入沿岸並影響雲量、能見度與對流發展。",
    "source_url": "https://glossary.ametsoc.org/wiki/onshore_wind"
  },
  {
    "english": "opacity",
    "traditional_chinese": "不透明度",
    "definition_cht": "「不透明度」指介質對光或其他電磁輻射通過的阻礙程度，用以綜合表示吸收與散射所造成的衰減強弱；數值愈大，表示輻射愈不易穿透該介質，在大氣輻射、雲微物理與天文物理中皆為重要參數。",
    "source_url": "https://glossary.ametsoc.org/wiki/opacity"
  },
  {
    "english": "opacus",
    "traditional_chinese": "不透明種",
    "definition_cht": "不透明種（opacus）是雲的變種之一，見於層雲、高層雲、高積雲與層積雲等，特徵為雲層厚而蔽光，觀測時通常無法辨認太陽或月亮的位置。",
    "source_url": "https://glossary.ametsoc.org/wiki/opacus"
  },
  {
    "english": "opaque sky cover",
    "traditional_chinese": "不透明雲量",
    "definition_cht": "不透明雲量指天空中被不透明雲遮蔽的覆蓋比例，即足以遮住日月輪廓的雲層所占天空份額；航空與地面觀測常將其與總雲量區分，以評估天空遮蔽程度。",
    "source_url": "https://glossary.ametsoc.org/wiki/opaque_sky_cover"
  },
  {
    "english": "open cells",
    "traditional_chinese": "開放胞狀對流",
    "definition_cht": "「開放胞狀對流」指邊界層中尺度對流的一種胞格型態，雲帶多沿胞格邊界分布，胞格中央相對較少雲或較晴朗；常見於冷空氣移經較暖海面時的海洋層積雲區，從衛星影像上常呈蜂巢狀結構。",
    "source_url": "https://glossary.ametsoc.org/wiki/open_cells"
  },
  {
    "english": "open channel flow",
    "traditional_chinese": "明渠流",
    "definition_cht": "明渠流指具有自由液面的通道水流，如河川、排水溝或渠道中的流動；其運動主要受重力控制，與充滿封閉管路、以壓力差主導的管流不同。",
    "source_url": "https://glossary.ametsoc.org/wiki/open_channel_flow"
  },
  {
    "english": "open system",
    "traditional_chinese": "開放系統",
    "definition_cht": "開放系統指可與外界交換物質及能量的系統；在大氣與海洋科學中，多數自然系統皆屬此類，因其邊界持續與周遭環境進行熱量、動量、水氣或其他成分交換。",
    "source_url": "https://glossary.ametsoc.org/wiki/open_system"
  },
  {
    "english": "open-cell cumulus",
    "traditional_chinese": "開放胞狀積雲",
    "definition_cht": "「開放胞狀積雲」指呈開放胞格排列的積雲或層積雲雲場，雲主要發展在胞格邊緣而中央較少雲；常出現在冷空氣爆發後的海洋邊界層，為開放胞狀對流的典型雲系表現。",
    "source_url": "https://glossary.ametsoc.org/wiki/open-cell_cumulus"
  },
  {
    "english": "Operational Linescan System",
    "traditional_chinese": "作業線掃描系統",
    "definition_cht": "「作業線掃描系統」(Operational Linescan System, OLS) 是美國國防氣象衛星計畫（DMSP）搭載的掃描式遙測儀器，可在可見光與熱紅外波段觀測雲系、夜間燈光、極光、海冰與地表背景亮度，長期廣用於氣象與環境遙測分析。",
    "source_url": "https://glossary.ametsoc.org/wiki/Operational_Linescan_System"
  },
  {
    "english": "operational numerical model",
    "traditional_chinese": "作業數值模式",
    "definition_cht": "作業數值模式指已投入日常預報作業的數值模式系統，定時同化最新觀測並產出天氣、海象或水文預報；其重點在穩定運轉、時效與可持續提供業務產品。",
    "source_url": "https://glossary.ametsoc.org/wiki/operational_numerical_model"
  },
  {
    "english": "operational weather limits",
    "traditional_chinese": "作業天氣限制",
    "definition_cht": "「作業天氣限制」指飛航、航海、地面作業或特定任務在執行時所容許的天氣條件門檻，例如風速、陣風、能見度、雲底高、降水、結冰或雷暴條件等；超出限制時，作業通常須延後、調整或中止。",
    "source_url": "https://glossary.ametsoc.org/wiki/operational_weather_limits"
  },
  {
    "english": "operative temperature",
    "traditional_chinese": "作用溫度",
    "definition_cht": "「作用溫度」是綜合空氣溫度與平均輻射溫度後，用以描述人體熱舒適感受的等效溫度指標；在低風速條件下，其常近似為兩者的加權平均，廣用於建築環境與熱舒適評估。",
    "source_url": "https://glossary.ametsoc.org/wiki/operative_temperature"
  },
  {
    "english": "operator",
    "traditional_chinese": "算子",
    "definition_cht": "算子指對函數、向量場或資料場施加某種數學運算的映射或運算元，如梯度、散度、旋度與微分算子；在數值模式與資料分析中常用來表述方程式中的運算形式。",
    "source_url": "https://glossary.ametsoc.org/wiki/operator"
  },
  {
    "english": "opposing wind",
    "traditional_chinese": "逆風",
    "definition_cht": "逆風指與物體運動方向相反、迎面吹來的風，即 headwind；在航空與航海中會降低對地速度、增加航程時間，起降時亦會影響性能與操作限制。",
    "source_url": "https://glossary.ametsoc.org/wiki/opposing_wind"
  },
  {
    "english": "opposition",
    "traditional_chinese": "衝",
    "definition_cht": "「衝」是天文學術語，指外行星、小行星或月球等天體與太陽在天球上分居地球兩側、黃經相差約 180 度的位置；此時該天體通常於日落前後升起、日出前後落下，整夜較易觀測，且常接近較大視直徑或較高亮度。",
    "source_url": "https://glossary.ametsoc.org/wiki/opposition"
  },
  {
    "english": "optical air mass",
    "traditional_chinese": "光學空氣質量",
    "definition_cht": "「光學空氣質量」指沿觀測視線穿越地球大氣的空氣量相對於天頂方向標準路徑的比值；天體愈接近地平線，光學空氣質量通常愈大，因此大氣消光、散射與折射效應也會更明顯。",
    "source_url": "https://glossary.ametsoc.org/wiki/optical_air_mass"
  },
  {
    "english": "optical counter",
    "traditional_chinese": "光學粒子計數器",
    "definition_cht": "「光學粒子計數器」是利用粒子穿越光束時產生的散射光、遮光或脈衝訊號進行偵測與計數的儀器，可估算粒子數濃度及粒徑分布；常用於氣膠、雲滴、潔淨室與空氣品質監測。",
    "source_url": "https://glossary.ametsoc.org/wiki/optical_counter"
  },
  {
    "english": "optical depth",
    "traditional_chinese": "光學厚度",
    "definition_cht": "「光學厚度」是描述輻射沿路徑穿越介質時，因吸收與散射累積所造成衰減程度的無因次量；數值愈大表示介質愈不易透光，在雲、氣膠與大氣輻射傳輸研究中為核心參數，亦常稱 optical thickness。",
    "source_url": "https://glossary.ametsoc.org/wiki/optical_depth"
  },
  {
    "english": "optical hygrometer",
    "traditional_chinese": "光學濕度計",
    "definition_cht": "「光學濕度計」是利用水汽對特定波長光的吸收、折射或其他光學效應量測濕度的儀器，可推算水汽混合比、露點或絕對濕度，常用於高精度大氣探測、機載觀測與實驗室校正。",
    "source_url": "https://glossary.ametsoc.org/wiki/optical_hygrometer"
  },
  {
    "english": "optical imaging probe",
    "traditional_chinese": "光學成像探針",
    "definition_cht": "「光學成像探針」指雲與降水微物理觀測中，利用高速光學成像記錄粒子穿越取樣區時之外形與尺度的探測器，可分析雨滴、雪粒、冰晶等粒子的大小、形狀與粒徑分布。",
    "source_url": "https://glossary.ametsoc.org/wiki/optical_imaging_probe"
  },
  {
    "english": "optical mass",
    "traditional_chinese": "光學空氣質量",
    "definition_cht": "「光學空氣質量」指光線穿越大氣時所經路徑長度相對於天頂方向標準路徑的比值；太陽高度愈低，光學空氣質量通常愈大，常用於估算大氣消光、輻射傳輸與觀測幾何效應。",
    "source_url": "https://glossary.ametsoc.org/wiki/optical_mass"
  },
  {
    "english": "optical meteor",
    "traditional_chinese": "光象",
    "definition_cht": "「光象」指由大氣中反射、折射、繞射或散射等光學作用所形成的可見現象，例如虹、暈、幻日、海市蜃樓與曙暮光等，屬於氣象光學的重要觀測對象。",
    "source_url": "https://glossary.ametsoc.org/wiki/optical_meteor"
  },
  {
    "english": "optical particle probe",
    "traditional_chinese": "光學粒子探測儀",
    "definition_cht": "「光學粒子探測儀」指利用粒子通過光束時造成的遮光、散射或成像訊號，量測雲滴、冰晶或降水粒子粒徑、數濃度與形狀特徵的儀器，常裝設於研究飛機或地面觀測系統。",
    "source_url": "https://glossary.ametsoc.org/wiki/optical_particle_probe"
  },
  {
    "english": "optical path",
    "traditional_chinese": "光路",
    "definition_cht": "「光路」指光線在介質中由一點傳至另一點所遵循的實際路徑；在大氣光學與遙測中，光路會受折射率分布、幾何配置與介質不均勻性影響。",
    "source_url": "https://glossary.ametsoc.org/wiki/optical_path"
  },
  {
    "english": "optical pathlength",
