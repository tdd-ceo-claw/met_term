[
  {
    "english": "Q band",
    "traditional_chinese": "Q 波段",
    "definition_cht": "電磁頻譜中屬於微波的頻帶之一，常約指 33–50 GHz，廣泛用於雷達、遙測、衛星通訊與高頻觀測系統。",
    "source_url": "https://glossary.ametsoc.org/wiki/Q_band"
  },
  {
    "english": "Q burst",
    "traditional_chinese": "Q 型爆發",
    "definition_cht": "地球—電離層腔體中觀測到的一種孤立型瞬變極低頻脈衝振盪，常與舒曼共振模態及強烈雷電放電活動有關。",
    "source_url": "https://glossary.ametsoc.org/wiki/Q_burst"
  },
  {
    "english": "Q code",
    "traditional_chinese": "Q 碼",
    "definition_cht": "一組以字母 Q 開頭的三字母標準縮略碼，用於無線電與航空通訊中快速傳遞固定訊息，氣象電報與作業通訊亦曾廣泛採用。",
    "source_url": "https://glossary.ametsoc.org/wiki/Q_code"
  },
  {
    "english": "Q noise",
    "traditional_chinese": "Q 雜訊",
    "definition_cht": "與閃電放電過程相關的一類準連續甚高頻輻射訊號，通常與預先電離通道上的快速 K-change 活動有關。",
    "source_url": "https://glossary.ametsoc.org/wiki/Q_noise"
  },
  {
    "english": "Q vector",
    "traditional_chinese": "Q 向量",
    "definition_cht": "準地轉理論中的診斷向量，用以綜合表示水平變形與溫度平流對垂直運動的強迫作用，常用於鋒生分析與 QG omega 方程診斷。",
    "source_url": "https://glossary.ametsoc.org/wiki/Q_vector"
  },
  {
    "english": "QPF",
    "traditional_chinese": "定量降水預報",
    "definition_cht": "對未來特定時段與區域累積降水量所作的定量預估，通常結合數值天氣預報、雷達、衛星與地面觀測資料，用於豪雨與洪水研判。",
    "source_url": "https://glossary.ametsoc.org/wiki/QPF"
  },
  {
    "english": "quadrant analysis",
    "traditional_chinese": "象限分析",
    "definition_cht": "將兩個擾動量依正負組合分入四個象限，以分析各類湍流事件對動量、熱量或水氣通量貢獻的統計方法，常見於邊界層與渦動相關研究。",
    "source_url": "https://glossary.ametsoc.org/wiki/quadrant_analysis"
  },
  {
    "english": "quadrant electrometer",
    "traditional_chinese": "象限靜電計",
    "definition_cht": "利用四象限電極結構量測極微弱電位差或電荷變化的高靈敏靜電儀器，可用於大氣電學與精密電學觀測。",
    "source_url": "https://glossary.ametsoc.org/wiki/quadrant_electrometer"
  },
  {
    "english": "quadrature",
    "traditional_chinese": "正交",
    "definition_cht": "指兩個波動、向量或數學分量彼此相差 90 度相位，或在內積意義下互相獨立的關係；常用於頻譜分析、座標轉換與訊號分解。",
    "source_url": "https://glossary.ametsoc.org/wiki/quadrature"
  },
  {
    "english": "quadrature spectrum",
    "traditional_chinese": "正交譜",
    "definition_cht": "兩個時間序列交叉頻譜的虛部，用以表示具有四分之一週期相位差之共同變異成分，常與共譜搭配分析相位關係與能量傳輸。",
    "source_url": "https://glossary.ametsoc.org/wiki/quadrature_spectrum"
  },
  {
    "english": "quality of snow",
    "traditional_chinese": "雪質",
    "definition_cht": "指雪層或雪粒的物理性質與狀態，如粒徑、形狀、密度、含水量、硬度與結合程度等；其差異會影響積雪穩定度、滑雪條件、融雪速率、雪崩風險與地表反照率。",
    "source_url": "https://glossary.ametsoc.org/wiki/quality_of_snow"
  },
  {
    "english": "quality of water",
    "traditional_chinese": "水質",
    "definition_cht": "指水體的物理、化學與生物性質綜合狀態，常以溫度、鹽度、酸鹼值、溶氧、濁度、營養鹽與污染物濃度等指標評估；在水文、海洋與環境氣象中用以判定水體適用性與變化情形。",
    "source_url": "https://glossary.ametsoc.org/wiki/quality_of_water"
  },
  {
    "english": "quantile",
    "traditional_chinese": "分位數",
    "definition_cht": "將已排序資料依機率或累積分布切分為若干等份時所對應的界值；在氣候與水文統計中常用於描述資料分布位置，並據以定義百分位數、四分位數與極端事件門檻。",
    "source_url": "https://glossary.ametsoc.org/wiki/quantile"
  },
  {
    "english": "quantitative precipitation estimation",
    "traditional_chinese": "定量降水估算",
    "definition_cht": "對已發生或正在發生之降水量所作的定量分析與推估，通常綜合雷達、雨量站、衛星及數值模式等資料，以估計特定區域與時段的累積降水量；常縮寫為 QPE。",
    "source_url": "https://glossary.ametsoc.org/wiki/quantitative_precipitation_estimation"
  },
  {
    "english": "quantitative precipitation forecast",
    "traditional_chinese": "定量降水預報",
    "definition_cht": "對未來特定時段與區域累積降水量所作的定量預測，通常以毫米或英寸表示，並結合數值天氣預報、雷達、衛星與地面觀測資料作業；常縮寫為 QPF。",
    "source_url": "https://glossary.ametsoc.org/wiki/quantitative_precipitation_forecast"
  },
  {
    "english": "quantum theory",
    "traditional_chinese": "量子理論",
    "definition_cht": "描述微觀粒子能量、輻射與物質交互作用之基本理論。在氣象學中常作為輻射傳輸、分子吸收與發射光譜，以及遙測反演等研究與應用的物理基礎。",
    "source_url": "https://glossary.ametsoc.org/wiki/quantum_theory"
  },
  {
    "english": "quartile",
    "traditional_chinese": "四分位數",
    "definition_cht": "將排序後資料分為四等份時所對應的三個界值，通常指第一、第二與第三四分位數；在氣候、水文與環境資料分析中常用以描述分布離散程度與異常範圍。",
    "source_url": "https://glossary.ametsoc.org/wiki/quartile"
  },
  {
    "english": "quasi steady state",
    "traditional_chinese": "準穩定狀態",
    "definition_cht": "指系統雖非完全穩定不變，但在一段時間內其主要結構、強度或收支關係變化緩慢，可近似視為穩定狀態處理；常用於雲系、對流系統、邊界層與數值模擬分析。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasi_steady_state"
  },
  {
    "english": "quasi-biennial oscillation",
    "traditional_chinese": "準兩年振盪",
    "definition_cht": "赤道平流層帶狀風在東風與西風之間交替變化的準週期振盪，平均週期約 24 至 30 個月，並隨時間由高層向下傳播；常縮寫為 QBO，對平流層環流、臭氧分布與熱帶對流具有重要影響。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasi-biennial_oscillation"
  },
  {
    "english": "quasi-equilibrium",
    "traditional_chinese": "準平衡",
    "definition_cht": "指系統雖持續演變，但主要物理過程在統計或平均意義下大致保持平衡的狀態。在氣象學中常用以描述對流加熱與大尺度環境強迫之間近似互相調節的情形。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasi-equilibrium"
  },
  {
    "english": "quasi-hydrostatic approximation",
    "traditional_chinese": "準靜力近似",
    "definition_cht": "在流體運動中假設垂直方向大致接近靜力平衡，但允許有限而較小的非靜力偏差，以保留主要垂直加速度效應的近似。此法常用於介於純靜力與完全非靜力模式之間的理論或數值模式。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasi-hydrostatic_approximation"
  },
  {
    "english": "quasi-Lagrangian coordinates",
    "traditional_chinese": "準拉格朗日座標",
    "definition_cht": "一種隨流體運動部分移動、但不完全與單一流體質點嚴格綁定的座標表示法，用以減少平流項的表達複雜度，並便於追蹤大氣或海洋中特定結構的演變。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasi-Lagrangian_coordinates"
  },
  {
    "english": "quasi-nondivergent",
    "traditional_chinese": "準非輻散",
    "definition_cht": "指流場雖非嚴格零散度，但其水平散度很小，可近似視為非輻散流。此概念常用於大尺度大氣動力分析，以簡化質量連續與渦度診斷。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasi-nondivergent"
  },
  {
    "english": "quasi-stationary front",
    "traditional_chinese": "準靜止鋒",
    "definition_cht": "移動極為緩慢、在連續天氣圖上位置變化很小的鋒面，常介於冷暖氣團之間，易造成雲雨帶滯留與持續性降水；亦可視為近似靜止鋒。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasi-stationary_front"
  },
  {
    "english": "quasi-stationary perturbation",
    "traditional_chinese": "準靜止擾動",
    "definition_cht": "指相對於背景流場移動很慢，或在一段時間內幾乎維持固定相位與位置的擾動。此類擾動常見於大尺度行星波、地形強迫波列或持續性環流異常分析。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasi-stationary_perturbation"
  },
  {
    "english": "quasigeostrophic",
    "traditional_chinese": "準地轉的",
    "definition_cht": "指流動或理論狀態大致接近地轉平衡，但仍保留小幅年齡轉向效應、垂直運動或渦度變化等偏離項；常用於描述中高緯大尺度大氣或海洋運動。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasigeostrophic"
  },
  {
    "english": "quasigeostrophic approximation",
    "traditional_chinese": "準地轉近似",
    "definition_cht": "在中高緯大尺度、緩慢變化流場中，假設運動接近地轉與靜力平衡，並將偏離量視為小量處理的動力近似；廣用於分析鋒生、渦度平流與垂直運動等問題。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasigeostrophic_approximation"
  },
  {
    "english": "quasigeostrophic current",
    "traditional_chinese": "準地轉流",
    "definition_cht": "指近似符合準地轉平衡的流動，其水平運動主要由科氏力與水平壓力梯度力近似平衡決定，但仍包含小幅年齡轉向與散度效應；可用於描述大尺度大氣氣流或海洋水流。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasigeostrophic_current"
  },
  {
    "english": "quasigeostrophic equations",
    "traditional_chinese": "準地轉方程組",
    "definition_cht": "描述接近地轉與靜力平衡之大尺度大氣或海洋運動的一組簡化方程，通常用於推導準地轉位渦、ω 方程與相關診斷工具，是中緯度天氣分析的重要理論基礎。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasigeostrophic_equations"
  },
  {
    "english": "quasigeostrophic equilibrium",
    "traditional_chinese": "準地轉平衡",
    "definition_cht": "指流場在大尺度上大致維持地轉平衡，並允許小幅偏離以支應緩慢演變與垂直運動的近似平衡狀態；為準地轉理論成立的核心前提之一。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasigeostrophic_equilibrium"
  },
  {
    "english": "quasigeostrophic motion",
    "traditional_chinese": "準地轉運動",
    "definition_cht": "指與「準地轉運動」相關的運動型態、運移過程或流體動力特徵。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasigeostrophic_motion"
  },
  {
    "english": "quasigeostrophic theory",
    "traditional_chinese": "準地轉理論",
    "definition_cht": "以地轉平衡為基礎並考慮小幅偏離的動力理論架構，是研究中緯度大尺度環流與擾動演變的重要工具。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasigeostrophic_theory"
  },
  {
    "english": "quasiperiodic",
    "traditional_chinese": "準週期的",
    "definition_cht": "指變化具有近似週期性但週期長度或振幅並非完全固定的特性。",
    "source_url": "https://glossary.ametsoc.org/wiki/quasiperiodic"
  },
  {
    "english": "Quaternary climate",
    "traditional_chinese": "第四紀氣候",
    "definition_cht": "指第四紀期間地球氣候的整體狀態與變遷特徵，包含冰期—間冰期循環及其環境回應。",
    "source_url": "https://glossary.ametsoc.org/wiki/Quaternary_climate"
  },
  {
    "english": "Quaternary period",
    "traditional_chinese": "第四紀",
    "definition_cht": "地質年代中最新的一個紀，包括更新世與全新世，常與冰期循環、人類演化及近代環境變遷研究相關。",
    "source_url": "https://glossary.ametsoc.org/wiki/Quaternary_period"
  },
  {
    "english": "quintile",
    "traditional_chinese": "五分位數",
    "definition_cht": "將一組排序資料平均分為五等分時所形成的分位界值或分組概念，常用於氣候統計與機率分級分析。",
    "source_url": "https://glossary.ametsoc.org/wiki/quintile"
  }
]
