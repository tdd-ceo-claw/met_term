  },
  {
    "english": "upper-level ridge",
    "traditional_chinese": "高空脊",
    "definition_cht": "高空等壓面或高度場向極地方向凸出的脊狀區域，代表相對較高的位勢高度，常伴隨反氣旋性曲率、下沉運動與較穩定天氣。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper-level_ridge"
  },
  {
    "english": "upper-level trough",
    "traditional_chinese": "高空槽",
    "definition_cht": "高空等壓面或高度場向赤道方向延伸的槽狀區域，代表相對較低的位勢高度，常伴隨氣旋性曲率、冷空氣與上升運動，對天氣變化具重要影響。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper-level_trough"
  },
  {
    "english": "uprush",
    "traditional_chinese": "上衝",
    "definition_cht": "指流體、氣流或波浪受動力作用而向上或向前上方急速衝升的運動；在海岸與波浪研究中，常指波水沿岸坡向上奔湧的階段。",
    "source_url": "https://glossary.ametsoc.org/wiki/uprush"
  },
  {
    "english": "upslope fog",
    "traditional_chinese": "上坡霧",
    "definition_cht": "潮濕而穩定的空氣沿山坡或高地被迫抬升，因絕熱冷卻達到飽和而形成的霧。",
    "source_url": "https://glossary.ametsoc.org/wiki/upslope_fog"
  },
  {
    "english": "upslope wind",
    "traditional_chinese": "上坡風",
    "definition_cht": "沿山坡由低處吹向高處的局地風，常因坡面受熱造成近地空氣上升而形成；白天較常見，並可促進地形抬升。",
    "source_url": "https://glossary.ametsoc.org/wiki/upslope_wind"
  },
  {
    "english": "upstream",
    "traditional_chinese": "上游",
    "definition_cht": "指相對於流動方向而言，位於來流來源一側或朝向源頭的一方；可用於河川、水流、氣流與波動傳播等情境。",
    "source_url": "https://glossary.ametsoc.org/wiki/upstream"
  },
  {
    "english": "upvalley wind",
    "traditional_chinese": "上谷風",
    "definition_cht": "沿山谷由谷口或低處吹向谷內上游、高處地區的局地風，多在白天因山谷受熱而形成，屬谷風環流的一部分。",
    "source_url": "https://glossary.ametsoc.org/wiki/upvalley_wind"
  },
  {
