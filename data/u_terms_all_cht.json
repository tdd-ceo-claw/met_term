    "source_url": "https://glossary.ametsoc.org/wiki/urban_boundary_layer"
  },
  {
    "english": "urban canopy",
    "traditional_chinese": "城市冠層",
    "definition_cht": "指與都市地表、人為熱源、排水系統或都市氣候效應相關的概念。",
    "source_url": "https://glossary.ametsoc.org/wiki/urban_canopy"
  },
  {
    "english": "urban canopy layer",
    "traditional_chinese": "城市冠層",
    "definition_cht": "指與「城市冠層」相關的大氣、海洋、湖泊或地表層結構，常依熱力、密度、濕度或動力特徵區分。",
    "source_url": "https://glossary.ametsoc.org/wiki/urban_canopy_layer"
  },
  {
    "english": "urban canyons",
    "traditional_chinese": "城市峽谷",
    "definition_cht": "指與都市地表、人為熱源、排水系統或都市氣候效應相關的概念。",
    "source_url": "https://glossary.ametsoc.org/wiki/urban_canyons"
  },
  {
    "english": "urban climate",
    "traditional_chinese": "城市氣候",
    "definition_cht": "指「城市氣候」所對應的氣候型態、區域氣候條件或其長期平均特徵。",
    "source_url": "https://glossary.ametsoc.org/wiki/urban_climate"
  },
  {
    "english": "urban climatology",
    "traditional_chinese": "城市氣候學",
    "definition_cht": "指與都市地表、人為熱源、排水系統或都市氣候效應相關的概念。",
    "source_url": "https://glossary.ametsoc.org/wiki/urban_climatology"
  },
  {
    "english": "urban effects",
    "traditional_chinese": "城市效應",
    "definition_cht": "指與都市地表、人為熱源、排水系統或都市氣候效應相關的概念。",
    "source_url": "https://glossary.ametsoc.org/wiki/urban_effects"
  },
  {
    "english": "Urban heat island",
    "traditional_chinese": "城市熱島",
    "definition_cht": "指與都市地表、人為熱源、排水系統或都市氣候效應相關的概念。",
    "source_url": "https://glossary.ametsoc.org/wiki/Urban_heat_island"
  },
  {
    "english": "urban hydrology",
    "traditional_chinese": "城市水文學",
    "definition_cht": "研究都市化對降雨逕流、滯洪、排水與地表水文反應影響的水文學分支。",
