[
  {
    "english": "u index",
    "traditional_chinese": "u 指數",
    "definition_cht": "以風場東西向分量（u 分量）為基礎建立的診斷指標，用於描述大尺度環流、風切變或振盪位相；其確切定義與計算方式依資料集與研究目的而異。",
    "source_url": "https://glossary.ametsoc.org/wiki/u_index"
  },
  {
    "english": "U.S. airways code",
    "traditional_chinese": "美國航路代碼",
    "definition_cht": "美國航空導航與航空氣象作業中用於識別國內航路的代碼系統，常見如低空 Victor 航路與高空 Jet 航路的路線編號。",
    "source_url": "https://glossary.ametsoc.org/wiki/U.S._airways_code"
  },
  {
    "english": "uala-andhi",
    "traditional_chinese": "烏拉安地",
    "definition_cht": "印度北部一帶對強陣風型塵暴或沙塵暴的地方名稱，通常伴隨突發強風、揚沙、能見度驟降，有時並夾帶雷暴。",
    "source_url": "https://glossary.ametsoc.org/wiki/uala-andhi"
  },
  {
    "english": "UARS",
    "traditional_chinese": "高層大氣研究衛星",
    "definition_cht": "Upper Atmosphere Research Satellite 的縮寫，為美國用於觀測平流層與中氣層之化學、輻射與動力過程的地球觀測衛星。",
    "source_url": "https://glossary.ametsoc.org/wiki/UARS"
  },
  {
    "english": "ubac",
    "traditional_chinese": "背陰坡",
    "definition_cht": "山地地形中背向日照、較陰冷潮濕的一側山坡；在氣候、積雪與植被分布研究中，常與向陽坡相對。",
    "source_url": "https://glossary.ametsoc.org/wiki/ubac"
  },
  {
    "english": "UHF",
    "traditional_chinese": "超高頻",
    "definition_cht": "ultra high frequency 的縮寫，指頻率介於 300 MHz 至 3 GHz 的無線電波段，常用於雷達、通訊與遙測。",
    "source_url": "https://glossary.ametsoc.org/wiki/UHF"
  },
  {
    "english": "Ulloa's ring",
    "traditional_chinese": "烏略亞環",
    "definition_cht": "與霧虹或榮光相關的大氣光象，指在雲霧微小水滴中因散射與繞射形成的淡白色環狀光帶。",
    "source_url": "https://glossary.ametsoc.org/wiki/Ulloa%27s_ring"
  },
  {
    "english": "ultimate infiltration capacity",
    "traditional_chinese": "極限入滲能力",
    "definition_cht": "在一定土壤與地表條件下，降雨持續足夠長時間後，入滲率所趨近的穩定值或最終入滲能力。",
    "source_url": "https://glossary.ametsoc.org/wiki/ultimate_infiltration_capacity"
  },
  {
    "english": "ultra high frequency",
    "traditional_chinese": "超高頻",
    "definition_cht": "指頻率介於 300 MHz 至 3 GHz 的電磁波頻帶，波長約為 1 公尺至 10 公分，常應用於無線通訊、雷達與遙測。",
    "source_url": "https://glossary.ametsoc.org/wiki/ultra_high_frequency"
  },
  {
    "english": "ultrafine particles",
    "traditional_chinese": "超細顆粒",
    "definition_cht": "粒徑小於 0.1 微米（100 奈米）的懸浮微粒，屬極細氣膠，對空氣品質、輻射作用、雲凝結過程與健康影響研究皆重要。",
    "source_url": "https://glossary.ametsoc.org/wiki/ultrafine_particles"
  },
  {
    "english": "ultrasonic",
    "traditional_chinese": "超音波的",
    "definition_cht": "指頻率高於人耳可聽範圍上限（約 20 kHz）的聲波或其相關技術；在氣象儀器中常見於超音波風速計。",
    "source_url": "https://glossary.ametsoc.org/wiki/ultrasonic"
  },
  {
    "english": "ultraviolet",
    "traditional_chinese": "紫外線的",
    "definition_cht": "指波長短於可見光紫端而長於 X 射線的電磁輻射性質，常用於描述輻射波段、感測器或光化學作用。",
    "source_url": "https://glossary.ametsoc.org/wiki/ultraviolet"
  },
  {
    "english": "ultraviolet radiation",
    "traditional_chinese": "紫外線輻射",
    "definition_cht": "波長約介於 10 至 400 奈米之間的電磁輻射；在大氣科學中常討論其與臭氧吸收、光化學反應及生物效應之關聯。",
    "source_url": "https://glossary.ametsoc.org/wiki/ultraviolet_radiation"
  },
  {
    "english": "Umkehr effect",
    "traditional_chinese": "烏姆克爾效應",
    "definition_cht": "利用天頂天空紫外輻射隨太陽天頂角變化時出現的反轉特徵，推估平流層臭氧垂直分布的光學效應與觀測方法。",
    "source_url": "https://glossary.ametsoc.org/wiki/Umkehr_effect"
  },
  {
    "english": "uncertainty",
    "traditional_chinese": "不確定度",
    "definition_cht": "指觀測、估計或模式結果可能偏離真值的程度，來源可包括量測誤差、抽樣不足、參數化假設及初始條件的不完備。",
    "source_url": "https://glossary.ametsoc.org/wiki/uncertainty"
  },
  {
    "english": "uncinus",
    "traditional_chinese": "鉤狀卷雲",
    "definition_cht": "雲學上指頂端彎曲如鉤或馬尾的卷雲形態，常見於高空強風與冰晶外展環境。",
    "source_url": "https://glossary.ametsoc.org/wiki/uncinus"
  },
  {
    "english": "unconfined aquifer",
    "traditional_chinese": "無承壓含水層",
    "definition_cht": "上部無明顯不透水層覆蓋、其上界為地下水位面的含水層，會直接受降水入滲與蒸發散影響。",
    "source_url": "https://glossary.ametsoc.org/wiki/unconfined_aquifer"
  },
  {
    "english": "undamped oscillation",
    "traditional_chinese": "無阻尼振盪",
    "definition_cht": "在理想條件下振幅不隨時間衰減的週期性振動，用以描述未受能量耗散影響的振盪系統。",
    "source_url": "https://glossary.ametsoc.org/wiki/undamped_oscillation"
  },
  {
    "english": "undercast",
    "traditional_chinese": "下覆雲層",
    "definition_cht": "航空氣象用語，指由飛機上方向下所見覆蓋下方地面的連續雲層或霧層。",
    "source_url": "https://glossary.ametsoc.org/wiki/undercast"
  },
  {
    "english": "undercurrent",
    "traditional_chinese": "下層流",
    "definition_cht": "位於主表層流之下、沿特定方向流動的次表層水流；常用於海洋與湖泊環流描述。",
    "source_url": "https://glossary.ametsoc.org/wiki/undercurrent"
  },
  {
    "english": "undermelting",
    "traditional_chinese": "底部融解",
    "definition_cht": "指冰體自下方發生的融解作用，常用於描述冰棚、海冰或冰川底面受較暖海水或水體影響而自底部消融的過程。",
    "source_url": "https://glossary.ametsoc.org/wiki/undermelting"
  },
  {
    "english": "undisturbed motion",
    "traditional_chinese": "未受擾動運動",
    "definition_cht": "在未引入任何擾動前，系統原有的穩態運動或本底運動狀態；常作為分析波動、擾動或不穩定發展時的基準流場。",
    "source_url": "https://glossary.ametsoc.org/wiki/undisturbed_motion"
  },
  {
    "english": "undular bore",
    "traditional_chinese": "波狀躍波",
    "definition_cht": "一種在穩定層結低層大氣中傳播的躍波，其後方伴隨一列振幅遞減的重力波；可由冷池外流、鋒面或海風觸發，並常伴隨條帶狀雲系。",
    "source_url": "https://glossary.ametsoc.org/wiki/undular_bore"
  },
  {
    "english": "undulatus",
    "traditional_chinese": "波狀",
    "definition_cht": "雲的變種之一，指雲片、雲層或雲帶呈規則起伏的波浪狀排列；常見於卷雲、高積雲、層積雲等，反映風切或波動作用。",
    "source_url": "https://glossary.ametsoc.org/wiki/undulatus"
  },
  {
    "english": "unfiltered model",
    "traditional_chinese": "未過濾模式",
    "definition_cht": "指在控制方程中保留流體系統全部動力模態的數值模式，不預先濾除重力波等快速振盪成分；相對於經濾波的近似模式而言。",
    "source_url": "https://glossary.ametsoc.org/wiki/unfiltered_model"
  },
  {
    "english": "unfreezing",
    "traditional_chinese": "解凍",
    "definition_cht": "凍結物質因吸熱而轉為未凍結狀態的過程，即冰、雪、凍土或凍結土壤發生融解與回復流動性的現象。",
    "source_url": "https://glossary.ametsoc.org/wiki/unfreezing"
  },
  {
    "english": "unidirectional vertical wind shear",
    "traditional_chinese": "單向垂直風切變",
    "definition_cht": "指垂直風切向量隨高度改變其強度但方向大致不變的情況；在風跡圖（hodograph）上通常呈近直線，但不表示各層風向必然完全相同。",
    "source_url": "https://glossary.ametsoc.org/wiki/unidirectional_vertical_wind_shear"
  },
  {
    "english": "unifilar electrometer",
    "traditional_chinese": "單線靜電計",
    "definition_cht": "一種靜電式靜電計，用於量測電位差或電荷效應；其敏感元件為單一細線或纖維的偏轉系統，曾用於大氣電學觀測。",
    "source_url": "https://glossary.ametsoc.org/wiki/unifilar_electrometer"
  },
  {
    "english": "uniform flow",
    "traditional_chinese": "均勻流",
    "definition_cht": "開放水道或管流中，各流動特性如水深、平均流速等沿流程方向不隨距離改變的流況。",
    "source_url": "https://glossary.ametsoc.org/wiki/uniform_flow"
  },
  {
    "english": "uniform layer",
    "traditional_chinese": "均勻層",
    "definition_cht": "日間大氣邊界層中部的良好混合層，受對流熱泡造成的強烈湍流影響，使位溫、風速與污染物濃度在垂直方向上近於均勻；其位置大致介於地表層之上、夾卷層或頂蓋逆溫之下。",
    "source_url": "https://glossary.ametsoc.org/wiki/uniform_layer"
  },
  {
    "english": "unimodal spectrum",
    "traditional_chinese": "單峰頻譜",
    "definition_cht": "在雷達都卜勒頻譜中僅具有一個主要峰值或模態的頻譜分布，表示回波速度成分主要集中於單一速度族群。",
    "source_url": "https://glossary.ametsoc.org/wiki/unimodal_spectrum"
  },
  {
    "english": "unit hydrograph",
    "traditional_chinese": "單位歷線",
    "definition_cht": "流域內在指定歷時內，均勻分布的一單位有效降雨所造成之出口流量歷線；其體積依定義等於一單位逕流量，為流域線性響應函數的近似表示。",
    "source_url": "https://glossary.ametsoc.org/wiki/unit_hydrograph"
  },
  {
    "english": "unit normal distribution",
    "traditional_chinese": "標準常態分布",
    "definition_cht": "平均數為 0、標準差為 1 的常態分布，常記為 N(0,1)，為統計標準化與機率計算中的基本分布。",
    "source_url": "https://glossary.ametsoc.org/wiki/unit_normal_distribution"
  },
  {
    "english": "unit storm",
    "traditional_chinese": "單位暴雨",
    "definition_cht": "指在整個集水區於指定歷時內，以均勻強度降下的一單位淨雨深；常作為推導單位歷線的理想化降雨輸入。",
    "source_url": "https://glossary.ametsoc.org/wiki/unit_storm"
  },
  {
    "english": "United States Coast Pilot",
    "traditional_chinese": "美國海岸航海指南",
    "definition_cht": "美國國家海洋暨大氣總署出版的一系列航海參考書，補充海圖未易呈現的資訊，包括航行規定、地標、航道與錨地特性、危險區、天氣、海冰、海流及港口設施等。",
    "source_url": "https://glossary.ametsoc.org/wiki/United_States_Coast_Pilot"
  },
  {
    "english": "universal functions",
    "traditional_chinese": "普適函數",
    "definition_cht": "在 Monin–Obukhov 相似理論中，用以描述無因次風切、溫度梯度等量與穩定度參數之關係的函數，可用於近地層湍流通量與剖面的參數化。",
    "source_url": "https://glossary.ametsoc.org/wiki/universal_functions"
  },
  {
    "english": "universal rain gauge",
    "traditional_chinese": "通用雨量計",
    "definition_cht": "一種稱重式雨量計，將集水容器中降水重量換算為降水深度，並以時鐘驅動的記錄裝置連續描記其隨時間的變化。",
    "source_url": "https://glossary.ametsoc.org/wiki/universal_rain_gauge"
  },
  {
    "english": "universal time",
    "traditional_chinese": "世界時",
    "definition_cht": "以地球自轉為基準的時間系統，形式上由與格林威治平恆星時相關的數學關係定義；依應用可指 UT0、UT1，或泛指現代作業常用之協調世界時（UTC）。",
    "source_url": "https://glossary.ametsoc.org/wiki/universal_time"
  },
  {
    "english": "universe",
    "traditional_chinese": "母體",
    "definition_cht": "在統計學中，指研究對象的全體集合，亦即抽樣所欲代表的全部個體或事件；在本詞條中 universe 與 population 同義。",
    "source_url": "https://glossary.ametsoc.org/wiki/universe"
  },
  {
    "english": "unlimited ceiling",
    "traditional_chinese": "無限制雲幕高度",
    "definition_cht": "航空氣象中指不存在可報告雲幕（ceiling）的情況，例如總雲量未達規定門檻、透明雲覆蓋過多，或地面遮蔽僅屬部分遮蔽且上方無破碎雲或密雲時。",
    "source_url": "https://glossary.ametsoc.org/wiki/unlimited_ceiling"
  },
  {
    "english": "unprotected thermometer",
    "traditional_chinese": "無防護溫度計",
    "definition_cht": "未加裝百葉箱、輻射遮罩或其他防護裝置、直接暴露於周圍環境中的溫度計；其讀值易受太陽輻射、地面輻射、降水與通風條件影響。",
    "source_url": "https://glossary.ametsoc.org/wiki/unprotected_thermometer"
  },
  {
    "english": "unrestricted visibility",
    "traditional_chinese": "無限制能見度",
    "definition_cht": "指視程未受霧、霾、降水、揚塵或地物遮蔽等因素明顯限制的狀態；在航空氣象中表示可見距離極佳，足以不構成作業上的視程限制。",
    "source_url": "https://glossary.ametsoc.org/wiki/unrestricted_visibility"
  },
  {
    "english": "unsaturated flow",
    "traditional_chinese": "不飽和流",
    "definition_cht": "指孔隙介質中在未達完全飽和時的水分流動，此時孔隙內同時含有空氣與水，流動受重力、毛細力與基質勢共同控制。",
    "source_url": "https://glossary.ametsoc.org/wiki/unsaturated_flow"
  },
  {
    "english": "unsaturated hydraulic conductivity",
    "traditional_chinese": "不飽和導水率",
    "definition_cht": "指土壤或其他孔隙介質在未飽和狀態下傳導水分的能力，會隨含水量或基質勢而變化，通常低於飽和導水率。",
    "source_url": "https://glossary.ametsoc.org/wiki/unsaturated_hydraulic_conductivity"
  },
  {
    "english": "unsaturated zone",
    "traditional_chinese": "不飽和帶",
    "definition_cht": "又稱包氣帶，指地表與地下水位之間未被水完全充滿的地層區域；其孔隙內同時存在空氣與水分。",
    "source_url": "https://glossary.ametsoc.org/wiki/unsaturated_zone"
  },
  {
    "english": "unsharp masking",
    "traditional_chinese": "非銳化遮罩",
    "definition_cht": "一種影像銳化技術，先以原始影像的模糊版本建立遮罩，再將其與原圖組合以強化邊緣與細節；常用於攝影、遙測與數位影像處理。",
    "source_url": "https://glossary.ametsoc.org/wiki/unsharp_masking"
  },
  {
    "english": "unstable air",
    "traditional_chinese": "不穩定空氣",
    "definition_cht": "指大氣層結具有靜力不穩定特性，空氣微團一旦受擾動而上升或下沉，傾向持續偏離原位置，因而有利於對流發展。",
    "source_url": "https://glossary.ametsoc.org/wiki/unstable_air"
  },
  {
    "english": "unstable air mass",
    "traditional_chinese": "不穩定氣團",
    "definition_cht": "指層結偏不穩定、容易產生垂直對流的氣團；常有利於積雲、陣雨、雷暴與陣風等天氣現象發展。",
    "source_url": "https://glossary.ametsoc.org/wiki/unstable_air_mass"
  },
  {
    "english": "unstable channel",
    "traditional_chinese": "不穩定河道",
    "definition_cht": "指河道形態在既有流量與輸砂條件下難以維持長期平衡，容易發生沖刷、淤積、側向遷移、分汊或改道的水道。",
    "source_url": "https://glossary.ametsoc.org/wiki/unstable_channel"
  },
  {
    "english": "unstable equilibrium",
    "traditional_chinese": "不穩定平衡",
    "definition_cht": "指系統雖暫處於平衡，但只要受到微小擾動便會遠離原平衡位置，且擾動傾向被放大而非被抑制。",
    "source_url": "https://glossary.ametsoc.org/wiki/unstable_equilibrium"
  },
  {
    "english": "unstable wave",
    "traditional_chinese": "不穩定波",
    "definition_cht": "指振幅會隨時間或沿傳播方向增長的波動擾動，常見於流體或大氣動力不穩定發展過程，並可能進一步導致轉捩或湍流。",
    "source_url": "https://glossary.ametsoc.org/wiki/unstable_wave"
  },
  {
    "english": "unsteady flow",
    "traditional_chinese": "非定常流",
    "definition_cht": "指流場中某一固定位置的流速、壓力、水位或流量等物理量會隨時間改變的流動；相對於定常流而言。",
    "source_url": "https://glossary.ametsoc.org/wiki/unsteady_flow"
  },
  {
    "english": "unterwind",
    "traditional_chinese": "下風側",
    "definition_cht": "舊用語，指位於物體、地形或觀測點背風的一側，即相對於來風方向的下風處；意義近似 leeward。",
    "source_url": "https://glossary.ametsoc.org/wiki/unterwind"
  },
  {
    "english": "upbank thaw",
    "traditional_chinese": "上岸融解",
    "definition_cht": "指河冰、湖冰或海冰沿岸上側首先發生的融解現象，常因近岸受地表增溫、日照或較暖水體影響，使冰層自岸邊向外退縮。",
    "source_url": "https://glossary.ametsoc.org/wiki/upbank_thaw"
  },
  {
    "english": "updraft curtains",
    "traditional_chinese": "上升氣流簾",
    "definition_cht": "指在強對流雲或雷暴中，由連續或並列上升氣流形成、外觀呈簾幕狀的垂直雲體或降水間隙結構，可用來辨識對流核心位置。",
    "source_url": "https://glossary.ametsoc.org/wiki/updraft_curtains"
  },
  {
    "english": "upglide cloud",
    "traditional_chinese": "上滑雲",
    "definition_cht": "指暖濕空氣沿較冷空氣層或等熵面緩慢上升（upglide）時形成的雲系，常見為層狀雲，並多與鋒面前方的大範圍雲雨區有關。",
    "source_url": "https://glossary.ametsoc.org/wiki/upglide_cloud"
  },
  {
    "english": "upgradient flux",
    "traditional_chinese": "逆梯度通量",
    "definition_cht": "指通量方向與平均梯度方向相反的輸送，例如熱量、動量或物質由低值區輸向高值區；常見於湍流或渦動造成的反梯度傳輸。",
    "source_url": "https://glossary.ametsoc.org/wiki/upgradient_flux"
  },
  {
    "english": "upper air",
    "traditional_chinese": "高空",
    "definition_cht": "相對近地層而言較高的大氣部分，通常指需藉探空氣球、雷達、航空器或衛星觀測的自由大氣區域。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper_air"
  },
  {
    "english": "upper atmosphere",
    "traditional_chinese": "高層大氣",
    "definition_cht": "地球大氣中位於對流層以上的統稱，通常涵蓋平流層、中氣層、熱層及更高區域；其研究重點包括化學組成、輻射收支、電離與動力過程。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper_atmosphere"
  },
  {
    "english": "Upper Atmosphere Research Satellite",
    "traditional_chinese": "高層大氣研究衛星",
    "definition_cht": "NASA 於 1991 年發射的地球觀測衛星，英文縮寫為 UARS，用於觀測平流層至熱層的大氣化學、輻射收支、風場與能量傳輸。",
    "source_url": "https://glossary.ametsoc.org/wiki/Upper_Atmosphere_Research_Satellite"
  },
  {
    "english": "upper front",
    "traditional_chinese": "高空鋒",
    "definition_cht": "指主要存在於高空、未必直接延伸至地面的鋒區或鋒面結構；常表現為溫度梯度、風向轉變與垂直運動帶，對雲系與降水分布有重要影響。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper_front"
  },
  {
    "english": "upper wind chart",
    "traditional_chinese": "高空風圖",
    "definition_cht": "以高空觀測資料繪製、表示一定氣壓面或高度上風向與風速分布的天氣圖，供分析高空氣流、噴流與大尺度環流之用。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper_wind_chart"
  },
  {
    "english": "upper-air climatology",
    "traditional_chinese": "高空氣候學",
    "definition_cht": "研究高空大氣各要素（如溫度、風、濕度與位勢高度）之長期平均狀態、季節變化與統計特徵的氣候學分支。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper-air_climatology"
  },
  {
    "english": "upper-air disturbance",
    "traditional_chinese": "高空擾動",
    "definition_cht": "指高空氣流中風向、風速、溫度場或位勢高度場出現明顯變化的擾動系統，常伴隨冷空氣、氣旋性曲率或急流影響，易促進雲系與降水發展。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper-air_disturbance"
  },
  {
    "english": "upper-air observation",
    "traditional_chinese": "高空觀測",
    "definition_cht": "利用探空氣球、測風設備、雷達、航空器或遙測儀器，對地面以上自由大氣中的氣壓、溫度、濕度、風等要素所做的觀測。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper-air_observation"
  },
  {
    "english": "upper-air sounding",
    "traditional_chinese": "高空探空",
    "definition_cht": "以探空氣球、無線電探空儀或其他遙測方式量測大氣隨高度變化之溫度、濕度、氣壓與風等垂直廓線的作業或結果。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper-air_sounding"
  },
  {
    "english": "upper-air station",
    "traditional_chinese": "高空觀測站",
    "definition_cht": "專門執行高空觀測或探空作業的氣象測站，定時取得自由大氣的溫度、濕度、風與氣壓等垂直分布資料。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper-air_station"
  },
  {
    "english": "upper-level anticyclone",
    "traditional_chinese": "高空反氣旋",
    "definition_cht": "位於高空的反氣旋性環流系統，通常表現為高壓脊或封閉高壓中心，伴隨順時針環流（北半球）、下沉運動與較穩定天氣。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper-level_anticyclone"
  },
  {
    "english": "upper-level chart",
    "traditional_chinese": "高空天氣圖",
    "definition_cht": "以高空觀測資料繪製的等壓面分析圖，常用於表示位勢高度、溫度、風場與濕度分布，以分析高空環流與天氣系統演變。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper-level_chart"
  },
  {
    "english": "upper-level cyclone",
    "traditional_chinese": "高空氣旋",
    "definition_cht": "位於高空的氣旋性環流系統，常呈槽線或封閉低壓形式，伴隨冷心結構、輻散與上升運動，常有利於雲系及降水發展。",
    "source_url": "https://glossary.ametsoc.org/wiki/upper-level_cyclone"
  },
  {
    "english": "upper-level rainband",
    "traditional_chinese": "高空雨帶",
